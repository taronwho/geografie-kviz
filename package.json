    "build:mapa": "node scripts/build-mapa.mjs",
    "build:mapa-tvary": "node scripts/build-mapa-tvary.mjs",
    "build:regiony": "node scripts/build-regiony.mjs",
    "build:casti": "node scripts/build-casti-mest.mjs",
    "build:zemepis": "node scripts/build-zemepis.mjs",
    "build:reky": "node scripts/build-reky.mjs",
    "build:fotky": "node scripts/build-fotky.mjs",
    "build:clanky": "node scripts/build-clanky.mjs",
    "build:historie": "node scripts/build-historie.mjs",
    "build:biologie": "node scripts/build-biologie.mjs",
    "build:chemie": "node scripts/build-chemie.mjs",
    "build:fyzika": "node scripts/build-fyzika.mjs",
    "build:vlajky": "node scripts/build-vlajky.mjs",
    "build:mytologie": "node scripts/build-mytologie.mjs",
    "build:geologie": "node scripts/build-geologie.mjs",
    "build:umeni": "node scripts/build-umeni.mjs",
    "build:architektura": "node scripts/build-architektura.mjs",
    "build:hudba": "node scripts/build-hudba.mjs",
    "build:literatura": "node scripts/build-literatura.mjs",
    "build:film": "node scripts/build-film.mjs",
    "build:sport": "node scripts/build-sport.mjs",
    "build:technika": "node scripts/build-technika.mjs",
    "build:jidlo": "node scripts/build-jidlo.mjs",
    "build:vynalezy": "node scripts/build-vynalezy.mjs",
    "build:souvislosti": "node scripts/build-souvislosti.mjs",
    "build:retezovka": "node scripts/build-retezovka.mjs",
    "build": "npm run build:icons && npm run build:css",
    "test": "node --test",
    "audit:photo-text": "node scripts/photo-text.mjs",
    "audit:photo-masks": "node scripts/photo-masks.mjs",
    "audit:questions": "node scripts/audit-questions.mjs",
