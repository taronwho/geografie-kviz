# Hlavičky pro Netlify. CSP povoluje skripty a styly jen z tohoto webu
# a připojení jen k Wikipedii a Wikidatům; obrázky z Wikimedia Commons, Unsplash a OpenStreetMap.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://upload.wikimedia.org https://images.unsplash.com https://tile.openstreetmap.org; connect-src 'self' https://cs.wikipedia.org https://www.wikidata.org; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/sw.js
  Cache-Control: no-cache
